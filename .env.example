# Local development only. Copy to .env: cp .env.example .env
# These passwords are for the dev container and are not secrets.

# Used by docker compose to initialise the db container.
POSTGRES_PASSWORD=postgres_dev
MIGRATOR_PASSWORD=migrator_dev
APP_PASSWORD=app_dev

# The application and the tests connect as the app role.
DATABASE_URL=postgres://diesel_app:app_dev@localhost:5433/diesel
# Migrations (pnpm db:migrate) and test database setup connect as the migration role.
MIGRATION_DATABASE_URL=postgres://diesel_migrator:migrator_dev@localhost:5433/diesel
